<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both, so the tests run on every framework the package ships for. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IncidentIo/IncidentIo.csproj" />
    <!-- Read by SchemaTests, to check the generated code against the schema. -->
    <None Include="../../openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
